# Let git normalise line endings for ordinary text files
* text=auto

# KiCad writes LF line endings on every OS; keep them LF so Windows
# checkouts don't flip every line and show a whole-file diff
*.kicad_pro   text eol=lf
*.kicad_sch   text eol=lf
*.kicad_pcb   text eol=lf
*.kicad_sym   text eol=lf
*.kicad_mod   text eol=lf
*.kicad_dru   text eol=lf
*.kicad_wks   text eol=lf
*.kicad_jobset text eol=lf
sym-lib-table text eol=lf
fp-lib-table  text eol=lf

# 3D models: store byte-for-byte, never convert
*.step binary
*.stp  binary
*.wrl  binary
